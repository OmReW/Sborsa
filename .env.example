# ==============================================================================
# Borsa-AI Örnek Çevre Değişkenleri (.env.example)
# Kullanım: Bu dosyayı '.env' olarak kopyalayıp değerleri kendinize göre güncelleyin.
# ==============================================================================

# Yerel LLM / Ollama Ayarları
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ozel-qwen:latest
OLLAMA_TIMEOUT_SECONDS=120.0
ANALYSIS_BATCH_SIZE=5

# Portföy Simülasyonu & Sermaye Yönetimi
SIMULATION_START_CAPITAL=100000.0
POSITION_ALLOCATION_PCT=0.10

# KAP Veri Çekme Ayarları
FETCH_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20.0
# Takip Edilecek Hisseler (Boş bırakılırsa tüm BIST 30 varsayılandır)
# WATCHLIST=THYAO,GARAN,ASELS,EREGL,EKGYO

# Veritabanı
DB_PATH=data/borsa.db

# Log Seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
